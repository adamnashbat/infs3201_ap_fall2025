{{#if message}}
<div>
    {{ message }}
</div>
{{/if}}
<h1>Create new account</h1>
<form method="post">
    First Name: <input name="firstName"><br>
    Last Name: <input name="lastName"><br>
    Username: <input name="username"><br>
    Password: <input name="password"><br>
    Email: <input name="email"><br> 
    <input type="submit">
</form>